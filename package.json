{
  "name": "droid-switch",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write src tests playwright.config.ts",
    "package:mac": "bash scripts/package-macos.sh",
    "package:windows": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^5.0.3"
  }
}
